<h1>Welcome to the Inventory Management System</h1>
<h2>Categories</h2>
<ul>
  <% categories.forEach(category => { %>
  <li>
    <%= category.name %> (<a href="/items/category/<%= category.id %>"
      >View Items</a
    >)
  </li>
  <% }) %>
</ul>
<a href="/categories/new">Add New Category</a>
<a href="/items/new">Add New Item</a>
